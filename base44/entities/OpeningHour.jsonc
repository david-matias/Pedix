{
  "name": "OpeningHour",
  "type": "object",
  "properties": {
    "establishment_id": {
      "type": "string"
    },
    "weekday": {
      "type": "number"
    },
    "opens_at": {
      "type": "string"
    },
    "closes_at": {
      "type": "string"
    },
    "closed": {
      "type": "boolean"
    }
  },
  "required": [
    "establishment_id",
    "weekday"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}