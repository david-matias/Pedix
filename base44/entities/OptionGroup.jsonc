{
  "name": "OptionGroup",
  "type": "object",
  "properties": {
    "establishment_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "selection": {
      "type": "string",
      "enum": [
        "SINGLE",
        "MULTIPLE"
      ],
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "required": {
      "type": "boolean"
    },
    "min_select": {
      "type": "number"
    },
    "max_select": {
      "type": "number"
    },
    "sort_order": {
      "type": "number"
    }
  },
  "required": [
    "product_id",
    "name",
    "selection"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}