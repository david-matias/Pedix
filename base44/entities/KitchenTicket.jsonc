{
  "name": "KitchenTicket",
  "type": "object",
  "properties": {
    "establishment_id": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "order_item_id": {
      "type": "string"
    },
    "station_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "QUEUED",
        "PREPARING",
        "DONE"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "green"
      ]
    },
    "item_name": {
      "type": "string"
    },
    "quantity": {
      "type": "number"
    },
    "options_text": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "order_number": {
      "type": "number"
    },
    "created_at": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "done_at": {
      "type": "string"
    }
  },
  "required": [
    "establishment_id",
    "order_id",
    "station_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}