{
  "name": "Product",
  "type": "object",
  "properties": {
    "establishment_id": {
      "type": "string"
    },
    "category_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price_cents": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "active": {
      "type": "boolean"
    },
    "sort_order": {
      "type": "number"
    },
    "station_id": {
      "type": "string"
    },
    "track_stock": {
      "type": "boolean"
    },
    "stock_qty": {
      "type": "number"
    },
    "stock_min": {
      "type": "number"
    }
  },
  "required": [
    "establishment_id",
    "name",
    "price_cents"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}