{
  "name": "Coupon",
  "type": "object",
  "properties": {
    "establishment_id": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "PERCENT",
        "FIXED"
      ],
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "value": {
      "type": "number"
    },
    "min_subtotal_cents": {
      "type": "number"
    },
    "starts_at": {
      "type": "string"
    },
    "ends_at": {
      "type": "string"
    },
    "max_uses": {
      "type": "number"
    },
    "used_count": {
      "type": "number"
    },
    "active": {
      "type": "boolean"
    }
  },
  "required": [
    "establishment_id",
    "code",
    "type",
    "value"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}