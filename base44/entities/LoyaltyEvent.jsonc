{
  "name": "LoyaltyEvent",
  "type": "object",
  "properties": {
    "establishment_id": {
      "type": "string"
    },
    "account_id": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "EARN",
        "REDEEM"
      ],
      "enumColors": [
        "green",
        "purple"
      ]
    },
    "points": {
      "type": "number"
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "establishment_id",
    "account_id",
    "type",
    "points"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}