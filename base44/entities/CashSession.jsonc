{
  "name": "CashSession",
  "type": "object",
  "properties": {
    "establishment_id": {
      "type": "string"
    },
    "opened_at": {
      "type": "string"
    },
    "closed_at": {
      "type": "string"
    },
    "opening_float_cents": {
      "type": "number"
    },
    "counted_cents": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "CLOSED"
      ],
      "enumColors": [
        "green",
        "gray"
      ]
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "establishment_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}