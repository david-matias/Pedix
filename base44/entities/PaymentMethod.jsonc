{
  "name": "PaymentMethod",
  "type": "object",
  "properties": {
    "establishment_id": {
      "type": "string"
    },
    "code": {
      "type": "string",
      "enum": [
        "CASH",
        "PIX",
        "CARD_ON_DELIVERY"
      ]
    },
    "label": {
      "type": "string"
    },
    "active": {
      "type": "boolean"
    },
    "asks_change": {
      "type": "boolean"
    }
  },
  "required": [
    "establishment_id",
    "code"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}