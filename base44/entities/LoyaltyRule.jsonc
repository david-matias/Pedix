{
  "name": "LoyaltyRule",
  "type": "object",
  "properties": {
    "establishment_id": {
      "type": "string"
    },
    "points_per_real": {
      "type": "number"
    },
    "reward_points": {
      "type": "number"
    },
    "reward_discount_cents": {
      "type": "number"
    }
  },
  "required": [
    "establishment_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}