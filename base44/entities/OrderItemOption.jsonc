{
  "name": "OrderItemOption",
  "type": "object",
  "properties": {
    "establishment_id": {
      "type": "string"
    },
    "order_item_id": {
      "type": "string"
    },
    "group_name": {
      "type": "string"
    },
    "option_name": {
      "type": "string"
    },
    "price_delta_cents": {
      "type": "number"
    }
  },
  "required": [
    "order_item_id",
    "option_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}