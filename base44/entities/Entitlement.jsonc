{
  "name": "Entitlement",
  "type": "object",
  "properties": {
    "establishment_id": {
      "type": "string"
    },
    "module": {
      "type": "string",
      "enum": [
        "BASE",
        "DELIVERY",
        "MESAS",
        "COZINHA",
        "GESTAO",
        "GROWTH"
      ],
      "enumColors": [
        "blue",
        "blue",
        "gray",
        "gray",
        "gray",
        "gray"
      ]
    },
    "enabled": {
      "type": "boolean"
    }
  },
  "required": [
    "establishment_id",
    "module"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}