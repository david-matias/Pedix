{
  "name": "Table",
  "type": "object",
  "properties": {
    "establishment_id": {
      "type": "string"
    },
    "number": {
      "type": "number"
    },
    "name": {
      "type": "string"
    },
    "seats": {
      "type": "number"
    },
    "area": {
      "type": "string",
      "enum": [
        "SALAO",
        "VARANDA"
      ],
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "active": {
      "type": "boolean"
    },
    "sort_order": {
      "type": "number"
    }
  },
  "required": [
    "establishment_id",
    "number"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.establishment_id": "{{user.data.establishment_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}